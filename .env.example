# ─── Sitio ───────────────────────────────────────────────────────────────
# URL canónica pública (sin barra final). En Vercel, si no se define, se usa
# automáticamente VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Email público de contacto (opcional). Si se deja vacío no se muestra.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Formulario de contacto (/api/contact) ───────────────────────────────
# Se entrega a TODOS los destinos configurados. Sin ninguno, en producción
# la API responde 503 y el formulario lo indica; en desarrollo solo se loguea.

# 1) Webhook genérico (n8n, Make, Zapier, CRM...). Recibe el lead en JSON.
CONTACT_WEBHOOK_URL=
# Secreto opcional enviado en la cabecera x-webhook-secret
CONTACT_WEBHOOK_SECRET=

# 2) Email vía Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# 3) Supabase (tabla public.contact_leads, ver supabase/contact_leads.sql)
#    SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
